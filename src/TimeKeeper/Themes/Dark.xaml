<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette, taken from the HTML prototype (index.html). -->
    <SolidColorBrush x:Key="WindowBrush" Color="#17283D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1C2F47" />
    <SolidColorBrush x:Key="BarBrush" Color="#122032" />
    <SolidColorBrush x:Key="DeskBrush" Color="#0F1B2A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F6FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4C2D1" />
    <SolidColorBrush x:Key="LineBrush" Color="#34495F" />
    <SolidColorBrush x:Key="FieldBrush" Color="#14243A" />
    <SolidColorBrush x:Key="FieldLineBrush" Color="#6B7C90" />
    <SolidColorBrush x:Key="FocusBrush" Color="#00AAED" />
    <SolidColorBrush x:Key="HoverBrush" Color="#26405C" />
    <SolidColorBrush x:Key="ActiveBrush" Color="#245375" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF9C8F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#00AAED" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#17283D" />
</ResourceDictionary>
