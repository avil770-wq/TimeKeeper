<Window x:Class="TimeKeeper.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Keeper – הגדרות"
        Width="560" Height="720" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Background="{DynamicResource BarBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Assets/TimeKeeper.ico">

    <Window.Resources>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,20,24,8">

            <!-- 1. General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="כללי" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,0,0,16"
                              IsChecked="{Binding StartWithWindows}" Content="הפעלה עם Windows" />

                    <TextBlock Text="קיצור מקלדת" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="לחץ בתוך השדה על הצירוף הרצוי. הקיצור עושה בדיוק מה שקליק על הפינה עושה." />
                    <TextBox x:Name="HotkeyBox" Width="200" HorizontalAlignment="Left" IsReadOnly="True"
                             IsReadOnlyCaretVisible="False" Cursor="Arrow" FlowDirection="LeftToRight"
                             AutomationProperties.Name="קיצור מקלדת. לחץ על הצירוף הרצוי" />
                    <TextBlock x:Name="HotkeyError" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

                    <TextBlock Text="ערכת נושא" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <RadioButton GroupName="Theme" Content="לפי Windows" IsChecked="{Binding ThemeSystem}" />
                    <RadioButton GroupName="Theme" Content="בהיר" IsChecked="{Binding ThemeLight}" />
                    <RadioButton GroupName="Theme" Content="כהה" IsChecked="{Binding ThemeDark}" />

                    <TextBlock Text="מיקום הפינה" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="גוררים את הפינה כדי להזיז אותה. אם היא נעלמה (למשל על מסך שנותק), מחזירים אותה מכאן." />
                    <Button x:Name="ResetPositionButton" Content="איפוס מיקום" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 2. Work hours -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="שעות עבודה" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                               Text="תזכורות שקטות מחוץ לשעות האלה (חוץ מתזכורת סוף יום)." />
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsWorkDay}" Content="{Binding Name}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" FlowDirection="LeftToRight"
                                             IsEnabled="{Binding IsWorkDay}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='שעת התחלה – {0}'}"
                                             Text="{Binding StartText, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                    <TextBlock Grid.Column="2" Text="–" Margin="8,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Style="{StaticResource NumberBox}" FlowDirection="LeftToRight"
                                             IsEnabled="{Binding IsWorkDay}"
                                             AutomationProperties.Name="{Binding Name, StringFormat='שעת סיום – {0}'}"
                                             Text="{Binding EndText, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Reminders -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="תזכורות" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NoTimerEnabled}"
                              Content="אין טיימר רץ" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource Row}" Margin="50,0,0,4">
                        <TextBlock Text="אחרי" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource NumberBox}" IsEnabled="{Binding NoTimerEnabled}"
                                 AutomationProperties.Name="דקות בלי טיימר עד תזכורת"
                                 Text="{Binding NoTimerAfterMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Text="דקות בלי טיימר" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}" Margin="50,0,0,16">
                        <TextBlock Text="שוב אחרי" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource NumberBox}" IsEnabled="{Binding NoTimerEnabled}"
                                 AutomationProperties.Name="דקות עד תזכורת חוזרת"
                                 Text="{Binding NoTimerRepeatMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Text="דקות אם התעלמו" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LongRunningEnabled}"
                              Content="טיימר רץ זמן רב" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource Row}" Margin="50,0,0,16">
                        <TextBlock Text="אחרי" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource NumberBox}" IsEnabled="{Binding LongRunningEnabled}"
                                 AutomationProperties.Name="שעות רצופות עד תזכורת"
                                 Text="{Binding LongRunningAfterHours, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Text="שעות רצופות" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IdleEnabled}"
                              Content="היעדרות בזמן שטיימר רץ" Margin="0,0,0,8" />
                    <StackPanel Style="{StaticResource Row}" Margin="50,0,0,16">
                        <TextBlock Text="אחרי" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Style="{StaticResource NumberBox}" IsEnabled="{Binding IdleEnabled}"
                                 AutomationProperties.Name="דקות חוסר פעילות"
                                 Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Text="דקות בלי פעילות" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EndOfDayEnabled}"
                              Content="טיימר רץ אחרי סוף היום" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" Margin="50,0,0,0"
                               Text="חצי שעה אחרי סוף שעות העבודה. פעם אחת לכל טיימר." />
                </StackPanel>
            </Border>

            <!-- 4. Account -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="חשבון" />
                    <TextBlock Text="כתובת הסביבה" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox FlowDirection="LeftToRight" AutomationProperties.Name="כתובת סביבת Dynamics"
                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"
                             Text="{Binding EnvironmentUrl, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,12"
                               Text="לדוגמה: https://bizaid.crm4.dynamics.com" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="התחברות והצגת המשתמש המחובר יתווספו בשלב הבא." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
