<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High Contrast: system colours only, no brand colours. Reloaded when HC toggles. -->
    <SolidColorBrush x:Key="WindowBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="BarBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="DeskBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="FieldLineBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ActiveBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
</ResourceDictionary>
