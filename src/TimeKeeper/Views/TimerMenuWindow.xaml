<Window x:Class="TimeKeeper.Views.TimerMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Keeper"
        Width="900" Height="460"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <Window.Resources>
        <Style x:Key="ColumnList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                            CornerRadius="4" Padding="8,0" MinHeight="40" Margin="4,1">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Long names end with "…"; the full text is in the tooltip. -->
        <DataTemplate x:Key="NameItem">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
        </DataTemplate>
        <!-- Task: title on top, request number below in small LTR text so it doesn't mix with Hebrew. -->
        <DataTemplate x:Key="TaskItem">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           FlowDirection="LeftToRight" TextAlignment="Right" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="12,10,12,6" />
        </Style>
    </Window.Resources>

    <Border Margin="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Three columns: client › project › task (right to left). -->
            <Grid x:Name="Columns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.7*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="לקוח" />
                    <ListBox x:Name="ClientList" Style="{StaticResource ColumnList}" ItemTemplate="{StaticResource NameItem}"
                             AutomationProperties.Name="לקוחות" />
                </DockPanel>
                <Rectangle Grid.Column="1" Fill="{DynamicResource LineBrush}" />
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="פרויקט" />
                    <ListBox x:Name="ProjectList" Style="{StaticResource ColumnList}" ItemTemplate="{StaticResource NameItem}"
                             AutomationProperties.Name="פרויקטים" />
                </DockPanel>
                <Rectangle Grid.Column="3" Fill="{DynamicResource LineBrush}" />
                <DockPanel Grid.Column="4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnTitle}" Text="משימה" />
                    <ListBox x:Name="TaskList" Style="{StaticResource ColumnList}" ItemTemplate="{StaticResource TaskItem}"
                             AutomationProperties.Name="משימות" />
                </DockPanel>
            </Grid>

            <!-- Shown instead of the columns when not signed in. -->
            <StackPanel x:Name="SignInPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="360">
                <TextBlock x:Name="SignInText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                           Text="כדי לראות לקוחות ומשימות צריך להתחבר." />
                <Button x:Name="SignInButton" Content="התחבר" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Left" Content="סגור" IsCancel="True" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Caption}"
                               FontSize="13" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
