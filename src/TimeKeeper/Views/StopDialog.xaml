<Window x:Class="TimeKeeper.Views.StopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Keeper – השלמת דיווח"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}" FontSize="14">

    <Border Margin="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="8" Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <!-- Main form -->
            <StackPanel x:Name="FormPanel">
                <TextBlock Text="השלמת דיווח" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                <TextBlock x:Name="TaskTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TaskContext" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,16" />

                <TextBlock Text="תיאור הפעילות" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="DescriptionBox" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" MaxLength="400"
                         AutomationProperties.Name="תיאור הפעילות" />
                <TextBlock x:Name="DescriptionError" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           Margin="0,4,0,0" Visibility="Collapsed" Text="כתוב תיאור קצר של הפעילות." />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="משך" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MinusButton" Content="−15" MinWidth="44" Padding="6,4"
                                    AutomationProperties.Name="הפחת 15 דקות" />
                            <TextBlock x:Name="DurationText" MinWidth="72" TextAlignment="Center" FontSize="20"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="PlusButton" Content="+15" MinWidth="44" Padding="6,4"
                                    AutomationProperties.Name="הוסף 15 דקות" />
                        </StackPanel>
                        <TextBlock x:Name="ExactText" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="תאריך" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DatePicker x:Name="DateBox" SelectedDateFormat="Short" FlowDirection="LeftToRight"
                                    AutomationProperties.Name="תאריך" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

                <DockPanel Margin="0,20,0,0" LastChildFill="False">
                    <Button x:Name="SaveButton" Content="שמור" DockPanel.Dock="Right" MinWidth="88"
                            Background="{DynamicResource FocusBrush}" Foreground="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource FocusBrush}" IsDefault="True" />
                    <Button x:Name="ContinueButton" Content="המשך את הטיימר" DockPanel.Dock="Right" Margin="8,0,0,0"
                            IsCancel="True" />
                    <Button x:Name="DeleteButton" Content="מחק" DockPanel.Dock="Left"
                            Foreground="{DynamicResource DangerBrush}" />
                </DockPanel>
            </StackPanel>

            <!-- Delete confirmation -->
            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="למחוק את הדיווח?" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,20"
                           Text="הטיימר ייעצר והזמן לא יירשם." />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmDeleteButton" Content="כן, מחק" Margin="0,0,8,0"
                            Foreground="{DynamicResource DangerBrush}" />
                    <Button x:Name="BackButton" Content="חזור" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
